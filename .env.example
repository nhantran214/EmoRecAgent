# Copy to .env and adjust. .env is gitignored.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=emorecagent

# --- TGI / OpenAI-compatible LLM server ---
# Stage-2 / agents (7B)
TGI_BASE_URL=http://localhost:8080
TGI_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ABSA validate/repair (3B) — use with: bash scripts/setup_tgi_absa.sh
TGI_BASE_URL_SMALL=http://localhost:8081
TGI_MODEL_SMALL_ID=Qwen/Qwen2.5-3B-Instruct
LLM_MODEL_SMALL=Qwen/Qwen2.5-3B-Instruct
# TGI_API_KEY=tgi-local

# JSON-grammar ABSA: prefer latency. Workers=64 + huge batches caused client timeouts
# (~300ms/tok, uncapped ~1024 new tokens). Client now caps max_tokens=384.
TGI_SMALL_MAX_CONCURRENT_REQUESTS=32
TGI_SMALL_MAX_BATCH_PREFILL_TOKENS=16384
TGI_SMALL_MAX_BATCH_TOTAL_TOKENS=32768
TGI_SMALL_MAX_WAITING_TOKENS=8
TGI_SMALL_CUDA_MEMORY_FRACTION=0.95
TGI_SMALL_MAX_TOTAL_TOKENS=8192
TGI_SMALL_MAX_INPUT_LENGTH=6144
ABSA_WORKERS=32

# Optional overrides for the 7B container
# TGI_MAX_CONCURRENT_REQUESTS=128
# TGI_MAX_BATCH_PREFILL_TOKENS=8192
