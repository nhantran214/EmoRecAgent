# =============================================================================
# EmoRecAgent — GitHub-safe ignores (code + configs in repo; data local)
# =============================================================================

# --- Raw & processed datasets (download: scripts/download_amazon_reviews.py) ---
/data/raw/
/data/processed/
/data/cache/
/data/downloads/
/data/**/*.jsonl
/data/**/*.parquet
/data/**/*.sqlite
/data/**/*.sqlite3
/data/**/*.sqlite-journal

# ABSA / HGT artifacts under data/
/data/**/absa_cache/
/data/**/hgt/
/data/**/*.pt
/data/**/*.manifest.json

# Gold-label workflow: keep README + small JSONL in repo if you choose
!data/labeled/
!data/labeled/**

# --- Run outputs ---
results/
runs/
logs/
*.log

# --- Caches ---
*.cache
.cache/
absa_cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Model checkpoints & embeddings (train locally) ---
checkpoints/
**/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
**/embeddings/
**/*_embeddings.npy
*.npy
!tests/**/*.npy

# --- Baseline vendored repos: code may be tracked; artifacts stay local ---
baseline/**/storage/
baseline/**/dataset/
baseline/**/datasets/
baseline/**/saved/
baseline/**/wandb/
baseline/**/*.inter
baseline/**/*.pkl
baseline/**/ml-1m*/
baseline/**/ml-1m_default/

# Nested baseline git dirs (clone separately; do not push as subtree)
baseline/**/.git/

# --- Neo4j local volume ---
neo4j_data/
neo4j_logs/

# --- Secrets / local env ---
.env
.env.local
.env.*.local
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Tooling / editor (local) ---
.DS_Store
.idea/
.vscode/
.cursor/
.compound-engineering/config.local.yaml

# --- Experiment trackers ---
wandb/
.mlflow/

# --- Large archives ---
*.jsonl.gz
*.tar.gz
*.tgz
*.zip
